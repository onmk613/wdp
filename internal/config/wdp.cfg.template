# wdp configuration file (TOML format)
[inventory]
path = "inventory.yaml"

[run]
forks = 20
task_timeout = 300
# 默认连接类型（空 = push；可选 ssh/push/agent/local）。fleet 级默认放这里，
# inventory 组 vars / 主机条目按序覆盖（优先级见 docs/04）
# conn = "push"

[ssh]
# 默认 SSH 用户（仅当 inventory 组 vars/主机条目与 ~/.ssh/config 均未显式
# 指定时生效；优先级：主机条目 > 组 vars > ~/.ssh/config > 此处，见 docs/04）
user = "root"
connect_timeout = 10
host_key_check = true

[agent]
port = 7602
# push 会话 CA 落盘目录（空 = ~/.wdp/push-ca）。会话 CA 有效期 1 天，
# 有效期内跨进程复用同一信任链，可经 `wdp ca show` 检视
# push_ca_dir = ""

# push 自举按目标平台的二进制表（覆盖用，默认无需配置）。
# 自举前探测目标平台（uname -sm）：同平台上传控制端自身，跨平台默认在
# 控制端可执行文件同级查找 wdp-<os>-<arch>（./build.sh 全平台构建的 bin
# 目录）；仅当二进制不在同一目录时才用此表显式指定
# [agent.push_binary]
# linux_amd64 = "/path/bin/wdp-linux-amd64"
# linux_arm64 = "/path/bin/wdp-linux-arm64"

[transfer]
max_download_mb = 2048
max_extract_mb = 2048
