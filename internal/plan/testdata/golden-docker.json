            ],
            "inventory_hostname": "d1"
          },
          "d2": {
            "ansible_host": "10.20.0.12",
            "group_names": [
              "docker"
            ],
            "inventory_hostname": "d2"
          }
        },
        "inventory_hostname": "d2",
        "log": {
          "driver": "json-file",
          "level": "warn",
          "max_file": 5,
          "max_size": "50m"
        },
        "play_batch": [
          "d1",
          "d2"
        ],
        "play_hosts": [
          "d1",
          "d2"
        ],
        "uninstall_remove_binaries": false,
        "version": "29.3.0"
      },
      "play": {
        "name": "安装 docker（官方静态包）",
        "hosts": "docker",
        "become": true
      },
      "tasks": [
        {
          "idx": 2,
          "label": "解析目标架构列表（values 优先，其次节点 facts，回退 x86_64）",
          "module": "set_fact",
          "rollback": "readonly",
          "args": {
            "download_arch_list": "{{ $list := list }}{{ if .download_archs }}{{ $list = .download_archs }}{{ else }}{{ range $h := index $.groups \"docker\" }}{{ $a := dig \"arch\" \"\" (index $.hostvars $h) }}{{ if $a }}{{ $list = append $list $a }}{{ end }}{{ end }}{{ end }}{{ if not $list }}{{ $list = list \"x86_64\" }}{{ end }}{{ to_json (uniq $list) }}"
          },
          "tags": [
            "download"
          ],
          "delegate_to": "localhost",
          "run_once": true
        },
        {
          "idx": 3,
          "label": "输出目标架构",
          "module": "debug",
          "rollback": "none",
          "args": {
            "msg": "目标架构: {{ .download_arch_list }}"
          },
          "tags": [
            "download"
          ],
          "delegate_to": "localhost",
          "run_once": true
        },
        {
          "idx": 4,
          "label": "下载 docker 官方静态包（原始 tgz）",
          "module": "shell",
          "rollback": "none",
          "free_form": "set -e\npkg=\"{{ .playbook_dir }}/packages/{{ .item }}\"\nmkdir -p \"$pkg\"\ntgz=\"$pkg/docker-{{ .version }}.tgz\"\nif [ -s \"$tgz\" ]; then echo \"cached: $tgz\"; exit 0; fi\necho \"fetch {{ .download_base }}/{{ .item }}/docker-{{ .version }}.tgz\"\ncurl -fSL --retry 3 --retry-delay 3 --retry-all-errors -C - --max-time 900 \\\n  -o \"$tgz.tmp\" \"{{ .download_base }}/{{ .item }}/docker-{{ .version }}.tgz\"\nmv \"$tgz.tmp\" \"$tgz\"\n",
          "loop": [
            "{{ .download_arch_list }}"
          ],
          "tags": [
            "download"
          ],
          "delegate_to": "localhost",
          "run_once": true
        },
        {
          "idx": 5,
          "label": "下载 compose / buildx cli 插件",
          "module": "shell",
          "rollback": "none",
          "free_form": "set -e\npkg=\"{{ .playbook_dir }}/packages/{{ .item }}\"\nmkdir -p \"$pkg\"\n# compose 发布名用 x86_64 风格架构（与 .item 一致），buildx 用 amd64/arm64\nbuildx_arch={{ if eq .item \"x86_64\" }}amd64{{ else }}arm64{{ end }}\nif [ ! -s \"$pkg/docker-compose\" ]; then\n  echo \"fetch docker-compose {{ .compose_version }} ({{ .item }})\"\n  curl -fSL --retry 3 --retry-delay 3 --retry-all-errors -C - --max-time 900 \\\n    -o \"$pkg/docker-compose.tmp\" \\\n    \"https://github.com/docker/compose/releases/download/{{ .compose_version }}/docker-compose-linux-{{ .item }}\"\n  mv \"$pkg/docker-compose.tmp\" \"$pkg/docker-compose\"\nfi\nif [ ! -s \"$pkg/docker-buildx\" ]; then\n  echo \"fetch docker-buildx {{ .buildx_version }} ({{ .item }})\"\n  curl -fSL --retry 3 --retry-delay 3 --retry-all-errors -C - --max-time 900 \\\n    -o \"$pkg/docker-buildx.tmp\" \\\n    \"https://github.com/docker/buildx/releases/download/{{ .buildx_version }}/buildx-{{ .buildx_version }}.linux-$buildx_arch\"\n  mv \"$pkg/docker-buildx.tmp\" \"$pkg/docker-buildx\"\nfi\nchmod 0755 \"$pkg/docker-compose\" \"$pkg/docker-buildx\"\n",
          "loop": [
            "{{ .download_arch_list }}"
          ],
          "tags": [
            "download"
          ],
          "delegate_to": "localhost",
          "run_once": true
        },
        {
          "idx": 6,
          "label": "不支持的架构直接失败（仅 x86_64 / aarch64）",
          "module": "shell",
          "rollback": "none",
          "free_form": "echo \"unsupported architecture: {{ .arch }}\" \u003e\u00262; exit 1",
          "when": [
            "{{ if eq (include \"docker.arch_alias\" .) \"unsupported\" }}yes{{ else }}no{{ end }}"
          ]
        },
        {
          "idx": 7,
          "label": "配置目录（daemon.json 与 cli 插件）",
          "module": "file",
          "rollback": "full",
          "args": {
            "mode": "0755",
            "path": "{{ .item }}",
            "state": "directory"
          },
          "loop": [
            "{{ .conf_dir }}",
            "{{ .cli_plugins_dir }}"
          ]
        },
        {
          "idx": 8,
          "label": "分发 docker 二进制（含内嵌 containerd）",
          "module": "artifact",
          "rollback": "full",
          "args": {
            "cache": "packages/{{ .arch }}/docker-{{ .version }}.tgz",
            "dest": "{{ .bin_dir }}",
            "members": [
              "containerd",
              "containerd-shim-runc-v2",
              "ctr",
              "docker",
              "docker-init",
              "docker-proxy",
              "dockerd",
              "runc"
            ],
            "mode": "0755",
            "url": "{{ .download_base }}/{{ .arch }}/docker-{{ .version }}.tgz"
          }
        },
        {
          "idx": 9,
          "label": "分发 docker compose 插件（release 名用 x86_64 风格架构）",
          "module": "artifact",
          "rollback": "full",
          "args": {
            "cache": "packages/{{ .arch }}/docker-compose",
            "dest": "{{ .cli_plugins_dir }}/docker-compose",
            "mode": "0755",
            "url": "https://github.com/docker/compose/releases/download/{{ .compose_version }}/docker-compose-linux-{{ .arch }}"
          }
        },
        {
          "idx": 10,
          "label": "分发 docker buildx 插件（release 名用 Go 风格架构）",
          "module": "artifact",
          "rollback": "full",
          "args": {
            "cache": "packages/{{ .arch }}/docker-buildx",
            "dest": "{{ .cli_plugins_dir }}/docker-buildx",
            "mode": "0755",
            "url": "https://github.com/docker/buildx/releases/download/{{ .buildx_version }}/buildx-{{ .buildx_version }}.linux-{{ include \"docker.arch_alias\" . }}"
          }
        },
        {
          "idx": 11,
          "label": "渲染 daemon.json",
          "module": "template",
          "rollback": "full",
          "args": {
            "dest": "{{ .conf_dir }}/daemon.json",
            "mode": "0644",
            "src": "templates/daemon.json.tpl"
          },
          "notify": [
            "重启 docker"
          ]
        },
        {
          "idx": 12,
          "label": "部署 docker 单元并启动",
          "module": "systemd_unit",
          "rollback": "none",
          "args": {
            "enabled": true,
            "name": "docker.service",
            "src": "templates/docker.service.tpl",
            "state": "started"
          },
          "notify": [
            "重启 docker"
          ]
        }
      ],
      "handlers": [
        {
          "idx": 13,
          "label": "重启 docker",
          "module": "service",
          "rollback": "none",
          "args": {
            "name": "docker",
            "state": "restarted"
          }
        }
      ]
    }
  ]
}
