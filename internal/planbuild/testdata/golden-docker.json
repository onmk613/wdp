  "payloads": null,
  "hosts": [
    {
      "play_idx": 0,
      "host": "d1",
      "conn": {
        "address": "d1",
        "port": 22,
        "user": "root",
        "conn": "agent",
        "host_key_check": true,
        "connect_timeout_sec": 10
      },
      "values": {
        "bin_dir": "/usr/bin",
        "buildx_download_base": "https://github.com/docker/buildx/releases/download",
        "buildx_version": "v0.33.0",
        "cli_plugins_dir": "/usr/local/lib/docker/cli-plugins",
        "compose_download_base": "https://github.com/docker/compose/releases/download",
        "compose_version": "v5.1.1",
        "data_dir": "/var/lib",
        "docker_version": "29.3.0",
        "download_base": "https://download.docker.com/linux/static/stable",
        "log": {
          "driver": "json-file",
          "level": "warn",
          "max_file": 5,
          "max_size": "50m"
        },
        "online_install": true,
        "uninstall_remove_binaries": false
      },
      "vars": {
        "ansible_host": "10.20.0.11",
        "bin_dir": "/usr/bin",
        "buildx_download_base": "https://github.com/docker/buildx/releases/download",
        "buildx_version": "v0.33.0",
        "cli_plugins_dir": "/usr/local/lib/docker/cli-plugins",
        "compose_download_base": "https://github.com/docker/compose/releases/download",
        "compose_version": "v5.1.1",
        "data_dir": "/var/lib",
        "docker_version": "29.3.0",
        "download_base": "https://download.docker.com/linux/static/stable",
        "group_names": [
          "docker"
        ],
        "groups": {
          "all": [
            "d1",
            "d2"
          ],
          "docker": [
            "d1",
            "d2"
          ]
        },
        "hosts": {
          "d1": {
            "address": "d1",
            "conn": "agent",
            "name": "d1"
          },
          "d2": {
            "address": "d2",
            "conn": "agent",
            "name": "d2"
          }
        },
        "hostvars": {
          "d1": {
            "ansible_host": "10.20.0.11",
            "group_names": [
              "docker"
            ],
            "inventory_hostname": "d1"
          },
          "d2": {
            "ansible_host": "10.20.0.12",
            "group_names": [
              "docker"
            ],
            "inventory_hostname": "d2"
          }
        },
        "inventory_hostname": "d1",
        "log": {
          "driver": "json-file",
          "level": "warn",
          "max_file": 5,
          "max_size": "50m"
        },
        "online_install": true,
        "play_batch": [
          "d1",
          "d2"
        ],
        "play_hosts": [
          "d1",
          "d2"
        ],
        "uninstall_remove_binaries": false
      },
      "play": {
        "hosts": ""
      },
      "tasks": [
        {
          "idx": 1,
          "label": "获取主机详细信息",
          "module": "set_fact",
          "rollback": "readonly"
        },
        {
          "idx": 2,
          "label": "主机架构判断",
          "module": "shell",
          "rollback": "none",
          "free_form": "echo \"unsupported architecture: {{ .arch }}\" \u003e\u00262; exit 1",
          "when": [
            "{{ if eq (include \"docker.arch_alias\" .) \"unsupported\" }}yes{{ else }}no{{ end }}"
          ]
        },
        {
          "idx": 3,
          "label": "创建目录",
          "module": "file",
          "rollback": "full",
          "args": {
            "mode": 493,
            "path": "{{ .item }}",
            "state": "directory"
          },
          "loop": [
            "{{.bin_dir}}",
            "{{.cli_plugins_dir}}",
            "{{.data_dir}}"
          ]
        },
        {
          "idx": 4,
          "label": "copy二进制",
          "module": "copy",
          "rollback": "full",
          "args": {
            "dest": "{{ .bin_dir }}",
            "mode": 493,
            "src": "{{ .item }}"
          },
          "when": [
            "{{ not .online_install }}"
          ],
          "loop": [
            "containerd",
            "containerd-shim-runc-v2",
            "ctr",
            "docker",
            "docker-init",
            "docker-proxy",
            "dockerd",
            "runc"
          ]
        },
        {
          "idx": 5,
          "label": "copy plugins",
          "module": "copy",
          "rollback": "full",
          "args": {
            "dest": "{{ .cli_plugins_dir }}",
            "mode": 493,
            "src": "{{ .item }}"
          },
          "when": [
            "{{ not .online_install }}"
          ],
          "loop": [
            "docker-compose",
            "docker-buildx"
          ]
        },
        {
          "idx": 6,
          "label": "下载docker",
          "module": "get_url",
          "rollback": "none",
          "args": {
            "dest": "/tmp/docker.tgz",
            "mode": 420,
            "url": "{{ .download_base }}/{{ .arch }}/docker-{{ .docker_version }}.tgz"
          },
          "when": [
            "{{ .online_install }}"
          ]
        },
        {
          "idx": 7,
          "label": "下载docker-compose",
          "module": "get_url",
          "rollback": "none",
          "args": {
            "dest": "{{ .cli_plugins_dir }}/docker-compose",
            "mode": 493,
            "url": "{{ .compose_download_base }}/{{ .compose_version }}/docker-compose-linux-{{ .arch }}"
          },
          "when": [
            "{{ .online_install }}"
          ]
        },
        {
          "idx": 8,
          "label": "下载docker-buildx",
          "module": "get_url",
          "rollback": "none",
          "args": {
            "dest": "{{ .cli_plugins_dir }}/docker-buildx",
            "mode": 493,
            "sha256": null,
            "url": "{{ .buildx_download_base }}/{{ .buildx_version }}/buildx-{{ .buildx_version }}.linux-{{ include \"docker.arch_alias\" . }}"
          },
          "when": [
            "{{ .online_install }}"
          ]
        },
        {
          "idx": 9,
          "label": "解压docker",
          "module": "unarchive",
          "rollback": "partial",
          "args": {
            "dest": "{{ .bin_dir }}",
            "members": [
              "containerd",
              "containerd-shim-runc-v2",
              "ctr",
              "docker",
              "docker-init",
              "docker-proxy",
              "dockerd",
              "runc"
            ],
            "src": "/tmp/docker.tgz"
          },
          "when": [
            "{{ .online_install }}"
          ]
        },
        {
          "idx": 10,
          "label": "删除tgz包",
          "module": "file",
          "rollback": "full",
          "args": {
            "path": "/tmp/docker.tgz",
            "state": "absent"
          },
          "when": [
            "{{ .online_install }}"
          ]
        },
        {
          "idx": 11,
          "label": "渲染 daemon.json",
          "module": "template",
          "rollback": "full",
          "args": {
            "dest": "/etc/docker/daemon.json",
            "mode": "0644",
            "src": "templates/daemon.json.tpl"
          }
        },
        {
          "idx": 12,
          "label": "渲染config.toml",
          "module": "template",
          "rollback": "full",
          "args": {
            "dest": "/etc/containerd/config.toml",
            "mode": "0644",
            "src": "templates/config.toml.tpl"
          }
        },
        {
          "idx": 13,
          "label": "部署 containerd 单元并启动",
          "module": "systemd_unit",
          "rollback": "none",
          "args": {
            "daemon_reload": true,
            "enabled": true,
            "name": "containerd.service",
            "src": "templates/containerd.service.tpl",
            "state": "started"
          }
        },
        {
          "idx": 14,
          "label": "部署 docker 单元并启动",
          "module": "systemd_unit",
          "rollback": "none",
          "args": {
            "daemon_reload": true,
            "enabled": true,
            "name": "docker.service",
            "src": "templates/docker.service.tpl",
            "state": "started"
          }
        }
      ]
    },
